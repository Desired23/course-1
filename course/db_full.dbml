  source_type varchar [not null]
  source_object_id integer [not null]
  source_group_key varchar [not null]
  visibility varchar [not null]
  language_code varchar [not null]
  error_message varchar [not null]
  attempts integer [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
  started_at datetime
  finished_at datetime
  course_id integer
  document_id integer
  lesson_id integer
}

Table lesson_comments_lessoncomment {
  content varchar [not null]
  votes integer [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
  id integer [pk, not null]
  lesson_id integer [not null]
  user_id integer [not null]
  parent_comment_id integer
}

Table lessons_lesson {
  title varchar [not null]
  description varchar
  content_type varchar [not null]
  content varchar
  video_url varchar
  file_path varchar
  duration integer
  is_free boolean [not null]
  order integer [not null]
  status varchar [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
  deleted_at datetime
  deleted_by_id integer
  is_deleted boolean [not null]
  id integer [pk, not null]
  coursemodule_id integer [not null]
  video_public_id varchar
}

Table notifications_notification {
  title varchar [not null]
  message varchar [not null]
  is_read boolean [not null]
  created_at datetime [not null]
  type varchar [not null]
  notification_code varchar
  related_id integer
  deleted_at datetime
  deleted_by_id integer
  is_deleted boolean [not null]
  updated_at datetime [not null]
  id integer [pk, not null]
  receiver_id integer [not null]
  sender_id integer
}

Table payment_details {
  id integer [pk, not null]
  price decimal [not null]
  discount decimal [not null]
  final_price decimal [not null]
  refund_amount decimal
  refund_date datetime
  refund_reason varchar
  refund_request_time datetime
  refund_response_code varchar
  refund_status varchar [not null]
  refund_transaction_id varchar
  created_at datetime [not null]
  deleted_at datetime
  deleted_by_id integer
  is_deleted boolean [not null]
  updated_at datetime [not null]
  course_id integer [not null]
  payment_id integer [not null]
  promotion_id integer
  gateway_attempt_count integer [not null]
  internal_note varchar
  last_gateway_attempt_at datetime
  last_gateway_error varchar
  next_retry_at datetime
  processing_lock_token varchar
  refund_timeline varchar [not null]
  processed_by_id integer
}

Table payments {
  amount decimal [not null]
  discount_amount decimal [not null]
  total_amount decimal [not null]
  transaction_id varchar
  payment_date datetime [not null]
  payment_status varchar [not null]
  payment_method varchar [not null]
  refund_amount decimal [not null]
  payment_gateway varchar [not null]
  gateway_response varchar
  created_at datetime [not null]
  updated_at datetime [not null]
  deleted_at datetime
  deleted_by_id integer
  is_deleted boolean [not null]
  id integer [pk, not null]
  promotion_id integer
  user_id integer [not null]
  payment_type varchar [not null]
  subscription_plan_id integer
  ipn_attempts integer [not null]
}

Table plan_courses {
  id integer [pk, not null]
  added_at datetime [not null]
  is_deleted boolean [not null]
  added_by_id integer
  course_id integer [not null]
  plan_id integer [not null]
  added_reason varchar
  removed_at datetime
  removed_by_id integer
  status varchar [not null]
  scheduled_removal_at datetime
}

Table registration_forms {
  id integer [pk, not null]
  type varchar [not null]
  title varchar [not null]
  description varchar
  is_active boolean [not null]
  version integer [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
  deleted_at datetime
  is_deleted boolean [not null]
  created_by_id integer
}

Table reviews_review {
  rating integer [not null]
  comment varchar
  status varchar [not null]
  likes integer [not null]
  report_count integer [not null]
  instructor_response varchar
  created_at datetime [not null]
  updated_at datetime [not null]
  deleted_at datetime
  deleted_by_id integer
  is_deleted boolean [not null]
  response_at datetime
  id integer [pk, not null]
  course_id integer [not null]
  user_id integer [not null]
  last_report_reason varchar
  last_reported_at datetime
}

Table subscription_plans {
  id integer [pk, not null]
  name varchar [not null]
  description varchar
  price decimal [not null]
  discount_price decimal
  duration_type varchar [not null]
  duration_days integer [not null]
  status varchar [not null]
  is_featured boolean [not null]
  max_subscribers integer
  instructor_share_percent decimal [not null]
  thumbnail varchar
  created_at datetime [not null]
  updated_at datetime [not null]
  deleted_at datetime
  is_deleted boolean [not null]
  created_by_id integer
  badge_text varchar
  features varchar [not null]
  highlight_color varchar
  icon varchar
  not_included varchar [not null]
  yearly_discount_percent decimal [not null]
}

Table subscription_usages {
  id integer [pk, not null]
  usage_type varchar [not null]
  usage_date date [not null]
  access_count integer [not null]
  consumed_minutes integer [not null]
  last_accessed_at datetime [not null]
  course_id integer [not null]
  enrollment_id integer
  user_id integer [not null]
  user_subscription_id integer [not null]
}

Table support_replies_supportreply {
  message varchar [not null]
  created_at datetime [not null]
  id integer [pk, not null]
  support_id integer [not null]
  user_id integer [not null]
  deleted_at datetime
  deleted_by_id integer
  is_deleted boolean [not null]
  updated_at datetime [not null]
  admin_id integer
}

Table transcripts_lessontranscript {
  id integer [pk, not null]
  language_code varchar [not null]
  status varchar [not null]
  origin varchar [not null]
  provider varchar [not null]
  version integer [not null]
  source_video_url_snapshot varchar [not null]
  detected_language_code varchar [not null]
  published_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
  lesson_id integer [not null]
  published_by_id integer
}

Table transcripts_transcriptchunk {
  id integer [pk, not null]
  chunk_index integer [not null]
  start_ms integer [not null]
  end_ms integer [not null]
  text varchar [not null]
  token_count integer [not null]
  source_segment_start integer [not null]
  source_segment_end integer [not null]
  transcript_id integer [not null]
}

Table transcripts_transcriptjob {
  id integer [pk, not null]
  status varchar [not null]
  trigger_source varchar [not null]
  provider varchar [not null]
  source_video_url_snapshot varchar [not null]
  language_code varchar [not null]
  error_message varchar [not null]
  attempts integer [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
  started_at datetime
  finished_at datetime
  lesson_id integer [not null]
}

Table transcripts_transcriptsegment {
  id integer [pk, not null]
  segment_index integer [not null]
  start_ms integer [not null]
  end_ms integer [not null]
  text varchar [not null]
  confidence float
  speaker_label varchar
  transcript_id integer [not null]
}

Table transcripts_transcriptword {
  id integer [pk, not null]
  word_index integer [not null]
  start_ms integer [not null]
  end_ms integer [not null]
  text varchar [not null]
  confidence float
  segment_id integer [not null]
}

Table user_subscriptions {
  id integer [pk, not null]
  status varchar [not null]
  start_date datetime [not null]
  end_date datetime
  auto_renew boolean [not null]
  cancelled_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
  is_deleted boolean [not null]
  payment_id integer
  plan_id integer [not null]
  user_id integer [not null]
  notified_7d boolean [not null]
  notified_3d boolean [not null]
}

