          <mxGeometry x="360" y="820" width="260" height="182" as="geometry" />
        </mxCell>
        <mxCell id="evt_f1" value="+ id : BigAutoField (PK)" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_evt"><mxGeometry y="26" width="260" height="26" as="geometry"/></mxCell>
        <mxCell id="evt_f2" value="+ conversation : FK Conversation" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_evt"><mxGeometry y="52" width="260" height="26" as="geometry"/></mxCell>
        <mxCell id="evt_f3" value="+ actor : FK User (nullable)" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_evt"><mxGeometry y="78" width="260" height="26" as="geometry"/></mxCell>
        <mxCell id="evt_f4" value="+ event_type : str" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_evt"><mxGeometry y="104" width="260" height="26" as="geometry"/></mxCell>
        <mxCell id="evt_f5" value="+ payload : JSON" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_evt"><mxGeometry y="130" width="260" height="26" as="geometry"/></mxCell>
        <mxCell id="evt_f6" value="+ created_at : datetime" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_evt"><mxGeometry y="156" width="260" height="26" as="geometry"/></mxCell>

        <!-- ===== UserChatPrivacy (chua trien khai) ===== -->
        <mxCell id="cls_prv" value="UserChatPrivacy  «schema only»" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=0;resizeParentMax=0;collapsible=0;swimlaneFillColor=#e1d5e7;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="820" width="280" height="234" as="geometry" />
        </mxCell>
        <mxCell id="prv_f1" value="+ id : BigAutoField (PK)" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_prv"><mxGeometry y="26" width="280" height="26" as="geometry"/></mxCell>
        <mxCell id="prv_f2" value="+ user : OneToOne User" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_prv"><mxGeometry y="52" width="280" height="26" as="geometry"/></mxCell>
        <mxCell id="prv_f3" value="+ allow_direct_messages : bool" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_prv"><mxGeometry y="78" width="280" height="26" as="geometry"/></mxCell>
        <mxCell id="prv_f4" value="+ show_online_status : bool" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_prv"><mxGeometry y="104" width="280" height="26" as="geometry"/></mxCell>
        <mxCell id="prv_f5" value="+ allow_group_invites : bool" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_prv"><mxGeometry y="130" width="280" height="26" as="geometry"/></mxCell>
        <mxCell id="prv_f6" value="+ read_receipts_enabled : bool" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_prv"><mxGeometry y="156" width="280" height="26" as="geometry"/></mxCell>
        <mxCell id="prv_f7" value="+ last_seen_visibility" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_prv"><mxGeometry y="182" width="280" height="26" as="geometry"/></mxCell>
        <mxCell id="prv_f8" value="+ updated_at : datetime" style="text;align=left;spacingLeft=6;" vertex="1" parent="cls_prv"><mxGeometry y="208" width="280" height="26" as="geometry"/></mxCell>

        <!-- ===== UserChatBlock ===== -->
        <mxCell id="cls_blk" value="UserChatBlock" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=0;resizeParentMax=0;collapsible=0;swimlaneFillColor=#e1d5e7;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="820" width="260" height="182" as="geometry" />
