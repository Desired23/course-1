        <!-- Legend -->
        <mxCell id="legend" value="Legend&#10;&#10;Blue  = Actor (User)&#10;Red   = 1-1 chat (direct, ChatRoom)&#10;Green = Conversation (direct/group/system)&#10;Yellow= Message sub-objects&#10;Purple= User block / privacy&#10;&#10;Solid arrow = mandatory FK&#10;Dashed arrow = nullable FK&#10;Diamond = composition (1..*)&#10;&#10;«schema only» (vien dut net):&#10;Bang da co schema nhung chua&#10;trien khai view/endpoint&#10;(PinnedMessage: ghim tin nhan,&#10; UserChatPrivacy: cau hinh&#10; rieng tu chat)." style="text;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
