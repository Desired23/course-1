        <mxCell id="blk_f6" value="« unique(blocker, blocked) »" style="text;align=left;spacingLeft=6;fontStyle=2;" vertex="1" parent="cls_blk"><mxGeometry y="156" width="260" height="26" as="geometry"/></mxCell>

